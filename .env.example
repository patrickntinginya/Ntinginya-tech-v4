# Copy to .env.local for local work. In production set these in Netlify:
# Site configuration > Environment variables. Never commit real values.

# Public site address, used for canonical URLs, sitemap and Open Graph. Falls back to Netlify's URL.
NEXT_PUBLIC_SITE_URL=

# Supabase (existing project). The URL and anon key are safe in the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Contact and Expert Network email notifications (Resend).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
